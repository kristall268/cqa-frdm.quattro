# Скопируйте в .env (файл в .gitignore) и заполните. Backend читает .env из backend/ или из корня репозитория.

# --- Данные организаторов: DEV GET-ссылка; backend сам подставляет group_id ---
ORGANIZER_DATASET_URL=

# --- PostgreSQL (docker compose up -d db) ---
DB_URL=jdbc:postgresql://localhost:5432/cqa
DB_USER=cqa
DB_PASSWORD=cqa

# --- Основная модель: любой OpenAI-совместимый Chat Completions ---
# Облако (Gemini):  https://generativelanguage.googleapis.com/v1beta/openai
# Локально (Ollama): http://localhost:11434/v1  (ключ не нужен)
# Если ключ и адрес не заданы — MockLlmClient (тестовые оценки с пометкой MOCK, не для сдачи).
LLM_BASE_URL=
LLM_API_KEY=
# можно несколько через запятую — резерв при 429/503/404
LLM_MODEL=
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0
LLM_MAX_PARALLEL=2

# --- Вторая модель-проверяющий (needsReview ⚠). Пусто — проверка выключена ---
LLM_VERIFIER_MODEL=
# LLM_VERIFIER_BASE_URL=
# LLM_VERIFIER_API_KEY=

# --- Резервный провайдер, если основной недоступен ---
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Выгрузка results.json (формат JSON 1.0) ---
TEAM_NAME=quattro
# local | external_api | hybrid ; пусто — определяется по LLM_BASE_URL
RESULTS_MODEL_MODE=

# --- Frontend: разрешённые адреса (через запятую) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
